# 复制为 .env 后填入自己的值；以下全部为占位符，不是真实凭据。
# 安全红线：本文件与 .env 都不要提交到 git。

# 网关监听地址
GATEWAY_LISTEN_ADDR=:8080

# Docker Compose 用的数据库账号：请填入你自己的值，不要用模板占位符。
POSTGRES_DB=REPLACE_DB
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_PASSWORD

# PostgreSQL。格式：postgres://用户:密码@主机:端口/库名?sslmode=disable
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/REPLACE_DB?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 客户 key 哈希用的 pepper：32 字节，base64 编码。
# 生成命令：openssl rand -base64 32
API_KEY_PEPPER_B64=REPLACE_BASE64_32_BYTES_PEPPER

# 上游 key 信封加密的主密钥：32 字节，base64 编码。
# 生成命令：openssl rand -base64 32
# 注意：轮换此值会让现有上游 key 无法解密，需重新写入。
UPSTREAM_MASTER_KEY_B64=REPLACE_BASE64_32_BYTES_MASTER_KEY

# 上游请求超时（流式请求要大于一次完整对话时长）
UPSTREAM_TIMEOUT=10m
UPSTREAM_HEADER_TIMEOUT=15s

# 用量异步批量落库
METERING_BATCH_SIZE=200
METERING_FLUSH_INTERVAL=1s

# 缓存 TTL
AUTH_CACHE_TTL=60s
ROUTE_CACHE_TTL=5s

# 日志级别
LOG_LEVEL=info

# ===== 运营后台（内部使用，必须双因素登录）=====
# 留空则不启用运营后台接口。请填入你自己的账号与密码，不要使用模板里的占位符。
ADMIN_USER=
ADMIN_PASSWORD=

# TOTP 私钥：Base32 字符串（无 padding，至少 16 字节），由你自己生成并妥善保管。
# 生成命令：openssl rand -base64 20 | tr -d '\n' | base32 | tr -d '='
# 生成后用任意 TOTP 客户端（如开源 Aegis/FreeOTP）扫码或手工录入同一私钥。
# 注意：这里填的是私钥本身，不要提交到 git；留空则运营后台拒绝所有业务请求。
ADMIN_TOTP_SECRET=

# 余额告警阈值（余额低于该值时进入异常告警列表，单位与充值金额一致）
ALERT_LOW_BALANCE_THRESHOLD=100

# ===== B 方案：用户自助注册 / 登录 / 购买 =====
# 用户站点公网地址（不含尾部 /），用于邮件里的回跳链接。
USER_PORTAL_URL=https://user.example.com
# 网关对外公网地址（不含尾部 /），用于拼接支付回调地址；填真实域名而不是 127.0.0.1。
PUBLIC_BASE_URL=https://gw.example.com

# SMTP 邮件（注册验证码）。SMTP_HOST 留空则不发信，注册流程会被禁用。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aiporto 智港 <no-reply@example.com>
# none / starttls / ssl
SMTP_TLS=starttls

# 支付宝电脑网站支付。ALIPAY_ENABLED=false 时不加载密钥，用户端不显示支付宝选项。
# 私钥与支付宝公钥都是 base64(PEM)：base64 -w0 app_private_key.pem
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_B64=
ALIPAY_PUBLIC_KEY_B64=
# 回调地址留空时自动用 PUBLIC_BASE_URL 拼默认值。
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# 微信支付 v3 Native 扫码。WECHAT_ENABLED=false 时不加载密钥。
# 商户私钥 base64(PEM)；APIv3Key 为 32 字节 base64（openssl rand -base64 32 不是正确来源，
# 应使用微信商户平台设置的同一把 APIv3 密钥再 base64 编码）。
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL_NO=
WECHAT_API_V3_KEY_B64=
WECHAT_PRIVATE_KEY_B64=
# 微信支付平台公钥（用于验回调签名），从商户平台「API 安全」下载后 base64(PEM)。
WECHAT_PLATFORM_PUBLIC_KEY_B64=
WECHAT_NOTIFY_URL=
