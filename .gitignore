# ===== 绝不能提交的敏感文件 =====
# 真实配置（含密钥、数据库密码）只留在服务器上
.env
.env.*
!.env.example
# 任何形式的私钥、证书、记录明文 key 的文件
*.key
*.pem
*.p12
seed*.txt
keys*.txt
secrets*

# ===== 依赖与构建产物（服务器上自动重建） =====
frontend/node_modules/
frontend/dist/
frontend-user/node_modules/
frontend-user/dist/
.toolcache/
# 离线安装包由 scripts/build-offline.sh 生成，不入库
aiporto-install.sh
.offline-stage/

# ===== 图标交付目录（生成的 PNG/ICO，前端 public 内的正式图标正常入库） =====
output/

# ===== 备份与日志（含业务数据） =====
backups/
snapshots/
*.dump
*.sql.gz
*.log

# ===== 系统文件 =====
.DS_Store
Thumbs.db
